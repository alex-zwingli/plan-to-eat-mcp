{
  "name": "plan-to-eat-mcp",
  "version": "0.2.0",
  "description": "Unofficial Plan to Eat (plantoeat.com) JSON API client and Model Context Protocol server.",
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "bin": {
    "plan-to-eat-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/server.js",
    "verify": "node dist/verify.js",
    "test": "node dist/test_server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "plan-to-eat",
    "plantoeat",
    "mcp",
    "model-context-protocol",
    "recipes",
    "meal-planner"
  ],
  "author": "Alex Zwingli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-zwingli/plan-to-eat-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
